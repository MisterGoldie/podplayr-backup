rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Custom-token uid is the Farcaster FID as a string ("7472").
    function isUid(fid) {
      return signedIn() && request.auth.uid == fid;
    }

    // Farcaster mini-app sessions can only write their own user docs.
    // Web / Base / no-profile clients have no auth and must still like,
    // play, follow, and cache — same as before this lock.
    function ownerOrUnsigned(fid) {
      return isUid(fid) || !signedIn();
    }

    function ownSearchOrUnsigned(fidValue) {
      return !signedIn() || string(fidValue) == request.auth.uid;
    }

    match /users/{fid} {
      allow read: if true;
      allow write: if ownerOrUnsigned(fid);

      match /followers/{followerFid} {
        allow read: if true;
        allow write: if ownerOrUnsigned(followerFid);
      }

      match /likes/{likeId} {
        allow read: if true;
        allow write: if ownerOrUnsigned(fid);
      }

      match /playHistory/{playId} {
        allow read: if true;
        allow write: if ownerOrUnsigned(fid);
      }

      match /following/{targetFid} {
        allow read: if true;
        allow write: if ownerOrUnsigned(fid);
      }
    }

    // Shared caches and play/like counts — no Farcaster login required.
    match /wallet_cache/{fid} {
      allow read, write: if true;
    }

    match /searchedusers/{fid} {
      allow read, write: if true;
    }

    match /user_searches/{searchId} {
      allow read: if true;
      allow create: if ownSearchOrUnsigned(request.resource.data.searching_fid);
      allow update: if false;
      allow delete: if ownSearchOrUnsigned(resource.data.searching_fid);
    }

    match /global_likes/{id} {
      allow read, write: if true;
    }

    match /global_plays/{id} {
      allow read, write: if true;
    }

    match /top_played/{id} {
      allow read, write: if true;
    }

    match /nfts/{id} {
      allow read, write: if true;
    }

    match /nft_plays/{id} {
      allow read, write: if true;
    }

    match /nft_details/{id} {
      allow read, write: if true;
    }

    match /user_likes/{id} {
      allow read, write: if true;
    }

    match /likes/{id} {
      allow read, write: if true;
    }

    match /search_interactions/{id} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
